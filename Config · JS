/* ============================================================
   TS TECH PARK — SHARED CONFIG & DATA LAYER
   ============================================================
   This file is loaded by BOTH index.html and admin.html so the
   two portals can read/write the same data.

   SUPABASE
   --------
   Fill these in once you create a project at supabase.com.
   Until then, the app falls back to a local simulation so
   everything still works for testing.
   ============================================================ */

const SUPABASE_URL = "YOUR_SUPABASE_PROJECT_URL";       // e.g. https://xxxxx.supabase.co
const SUPABASE_ANON_KEY = "YOUR_SUPABASE_ANON_KEY";      // anon/public key from Project Settings > API

const SUPABASE_CONFIGURED =
  SUPABASE_URL && !SUPABASE_URL.startsWith("YOUR_") &&
  SUPABASE_ANON_KEY && !SUPABASE_ANON_KEY.startsWith("YOUR_");

let supabaseClient = null;
if (SUPABASE_CONFIGURED && window.supabase) {
  supabaseClient = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
}

/* ------------------------------------------------------------
   LOCAL DATA STORE
   All app data (users, courses, payments, live links, activity)
   lives in localStorage under these keys so index.html and
   admin.html can share it on the same origin.

   IMPORTANT: localStorage is per-browser, not a real shared
   database. For a real multi-user production system, this
   layer should be replaced with Supabase Postgres tables
   (the function names below are written so that swap is a
   drop-in later — see README.md).
------------------------------------------------------------ */
const DB = {
  KEYS: {
    USERS: "ts_db_users",
    COURSES: "ts_db_courses",
    PAYMENTS: "ts_db_payments",
    ENROLLMENTS: "ts_db_enrollments",
    LIVE: "ts_db_live",
    FORUM: "ts_db_forum",
    ACTIVITY: "ts_db_activity",
    ADMIN: "ts_db_admin",
    SESSION: "ts_db_session",
  },

  _get(key, fallback) {
    try {
      const raw = localStorage.getItem(key);
      return raw ? JSON.parse(raw) : fallback;
    } catch (e) {
      console.error("DB read error", key, e);
      return fallback;
    }
  },
  _set(key, val) {
    try {
      localStorage.setItem(key, JSON.stringify(val));
      return true;
    } catch (e) {
      console.error("DB write error", key, e);
      return false;
    }
  },

  // ---- Users (students + instructors) ----
  getUsers() { return this._get(this.KEYS.USERS, []); },
  saveUsers(list) { return this._set(this.KEYS.USERS, list); },
  findUserByEmail(email) {
    return this.getUsers().find(u => u.email.toLowerCase() === (email || "").toLowerCase());
  },
  upsertUser(user) {
    const list = this.getUsers();
    const idx = list.findIndex(u => u.id === user.id);
    if (idx >= 0) list[idx] = user; else list.push(user);
    this.saveUsers(list);
    return user;
  },

  // ---- Courses (created by instructors/admin — none pre-seeded) ----
  getCourses() { return this._get(this.KEYS.COURSES, []); },
  saveCourses(list) { return this._set(this.KEYS.COURSES, list); },
  upsertCourse(course) {
    const list = this.getCourses();
    const idx = list.findIndex(c => c.id === course.id);
    if (idx >= 0) list[idx] = course; else list.push(course);
    this.saveCourses(list);
    return course;
  },
  deleteCourse(id) {
    this.saveCourses(this.getCourses().filter(c => c.id !== id));
  },

  // ---- Payments ----
  getPayments() { return this._get(this.KEYS.PAYMENTS, []); },
  addPayment(p) {
    const list = this.getPayments();
    list.unshift(p);
    this._set(this.KEYS.PAYMENTS, list);
    return p;
  },

  // ---- Enrollments ----
  getEnrollments() { return this._get(this.KEYS.ENROLLMENTS, []); },
  addEnrollment(e) {
    const list = this.getEnrollments();
    list.push(e);
    this._set(this.KEYS.ENROLLMENTS, list);
    return e;
  },
  enrollmentsForUser(userId) {
    return this.getEnrollments().filter(e => e.userId === userId);
  },

  // ---- Live classes / streaming links (posted by admin/instructor) ----
  getLive() { return this._get(this.KEYS.LIVE, []); },
  saveLive(list) { return this._set(this.KEYS.LIVE, list); },
  addLive(item) {
    const list = this.getLive();
    list.unshift(item);
    this.saveLive(list);
    return item;
  },

  // ---- Forum ----
  getForum() { return this._get(this.KEYS.FORUM, []); },
  saveForum(list) { return this._set(this.KEYS.FORUM, list); },

  // ---- Activity log (for admin "recent activity") ----
  getActivity() { return this._get(this.KEYS.ACTIVITY, []); },
  logActivity(entry) {
    const list = this.getActivity();
    list.unshift({ time: new Date().toISOString(), ...entry });
    this._set(this.KEYS.ACTIVITY, list.slice(0, 200));
  },

  // ---- Admin credentials (demo-grade; see README) ----
  getAdminConfig() {
    return this._get(this.KEYS.ADMIN, {
      username: "admin",
      password: "TsTechPark@2026", // change this immediately in admin Settings
    });
  },
  saveAdminConfig(cfg) { return this._set(this.KEYS.ADMIN, cfg); },
};

/* Small id helper */
function uid(prefix) {
  return (prefix || "id") + "_" + Date.now().toString(36) + Math.random().toString(36).slice(2, 7);
}

function fmtMoney(n) {
  return "₹" + Number(n || 0).toLocaleString("en-IN");
}

function fmtDateTime(iso) {
  const d = new Date(iso);
  return d.toLocaleDateString("en-IN", { day: "2-digit", month: "short", year: "numeric" }) +
    " · " + d.toLocaleTimeString("en-IN", { hour: "2-digit", minute: "2-digit" });
}
